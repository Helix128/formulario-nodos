# Generate this value with: python scripts/generate_password_hash.py
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace_me
# Long random secret used to sign admin sessions.
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=data/nodos.sqlite3
# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
